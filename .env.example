# URL pública final para canonical, OpenGraph e sitemap.
NEXT_PUBLIC_SITE_URL=

# E-mail de contato exibido (alternativamente, definido em src/data/contactData.ts).
NEXT_PUBLIC_CONTACT_EMAIL=

# Canais profissionais opcionais (adicione URLs verdadeiras).
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Formulário Formspree (ID obtido em https://formspree.io/).
# Sem este ID o formulário não envia, mas o e-mail direto continua disponível.
NEXT_PUBLIC_FORMSPREE_FORM_ID=
